datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Dificultad {
  BAJA
  MEDIA
  ALTA
}

enum EstadoTema {
  PENDIENTE
  EN_PROGRESO
  DOMINADO
}

model Usuario {
  id       Int       @id @default(autoincrement())
  nombre   String
  email    String    @unique
  creadoEn DateTime  @default(now())
  materias Materia[]
}

model Materia {
  id        Int      @id @default(autoincrement())
  nombre    String
  docente   String?
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  temas     Tema[]
  examenes  Examen[]
}

model Tema {
  id         Int        @id @default(autoincrement())
  titulo     String
  dificultad Dificultad @default(MEDIA)
  estado     EstadoTema @default(PENDIENTE)
  materiaId  Int
  materia    Materia    @relation(fields: [materiaId], references: [id], onDelete: Cascade)
}

model Examen {
  id        Int      @id @default(autoincrement())
  titulo    String
  fecha     DateTime
  materiaId Int
  materia   Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
}
